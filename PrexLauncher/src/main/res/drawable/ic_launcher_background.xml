<?xml version="1.0" encoding="utf-8"?>
<!-- App icon background: brand magenta-to-purple gradient (no image, so the icon reads
     as a clean logo: gradient tile + white "P" mark in the foreground layer). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#571FA8"
                android:centerColor="#C41CA9"
                android:startColor="#FF2D6F"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
