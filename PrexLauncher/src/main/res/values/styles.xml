<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <!-- Theme overlay applied to the redesigned dark settings pages -->
    <style name="ThemePrexSettings" parent="@style/AppTheme">
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textColorPrimary">@color/settings_text_primary</item>
        <item name="android:textColorSecondary">@color/settings_text_secondary</item>
        <item name="android:textColorHint">@color/settings_text_secondary</item>
        <item name="android:colorAccent">@color/prex_accent</item>
        <item name="colorAccent">@color/prex_accent</item>
        <item name="android:colorControlActivated">@color/prex_accent</item>
        <item name="android:colorControlHighlight">@color/settings_row_pressed</item>
        <item name="android:windowBackground">@color/settings_bg</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
